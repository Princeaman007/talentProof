# Backend Environment Variables
# ⚠️  IMPORTANT: Copier ce fichier en .env et remplir avec VOS VRAIES VALEURS
# ⚠️  NE JAMAIS commiter le fichier .env dans Git

# Database
MONGODB_URI=mongodb://localhost:27017/talentproof
# Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>

# JWT (GÉNÉRER UN SECRET FORT)
# Commande: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_32_CHAR_SECRET
JWT_EXPIRE=24h
# Refresh token expiration in milliseconds (default 7 days)
REFRESH_TOKEN_EXPIRE_MS=604800000

# DEPRECATE_TOKEN_IN_BODY: set to 'true' to stop returning access tokens in API responses
# Prefer cookies for token delivery; set to 'true' once frontend is fully migrated
DEPRECATE_TOKEN_IN_BODY=false

# Email Service
EMAIL_HOST=smtp.gmail.com
# Production Infomaniak: mail.infomaniak.com
EMAIL_PORT=587
# Production Infomaniak: 2525 (Render bloque 587)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=CHANGE_ME_YOUR_EMAIL_PASSWORD
EMAIL_FROM=TalentProof <noreply@talentproof.com>

# SKIP_EMAILS - Set to 'true' in development to skip sending emails
SKIP_EMAILS=false

# Email testing modes:
# - 'ethereal' (default when NODE_ENV=test): use Ethereal test account and log preview URL
# - 'noop': use a noop/json transport (fast, no external network)
# - 'noop' is recommended in CI for speed; set EMAIL_TEST_MODE=noop in CI
EMAIL_TEST_MODE=ethereal

# Explicit TLS/email settings
# Set to 'true' to force secure SMTP (port 465) or when your provider requires TLS
EMAIL_SECURE=false
# Only set to 'true' if you explicitly allow invalid/self-signed certs (discouraged in prod)
EMAIL_ALLOW_INVALID_CERT=false

# Client URL (for confirmation links)
CLIENT_URL=http://localhost:5173

# CSRF settings
# By default the server exposes /api/csrf-token which returns a token to be sent in the
# `X-CSRF-Token` header for mutating requests. Leave empty to use defaults.
CSRF_COOKIE_NAME=_csrf
CSRF_TOKEN_HEADER=X-CSRF-Token

# Redis (optional) - used for rate-limiting and job queues
# Example: REDIS_URL=redis://localhost:6379
REDIS_URL=

# Enable enqueuing emails to Redis-backed job queue when REDIS_URL is set.
# Set to 'true' to always use queue; when unset the queue will be used only if REDIS_URL is present.
EMAIL_QUEUE=true

# Server
NODE_ENV=development
PORT=5000

# ✅ SÉCURITÉ - Origines CORS autorisées (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://talentproof.com

# Admin email (legacy, deprecated - use role field in database)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ⚠️  SECURITY WARNING ⚠️
# JAMAIS DE VRAIES VALEURS DANS CE FICHIER
# Ce fichier est un TEMPLATE - vos vraies valeurs vont dans .env (non commité)
